flowchart TD
  N["State Variables n"]
  R["Independent Constraints r"]
  DOF["DoF ≈ n - r"]
  POS["Positive DoF (>0)"]
  ZER["Zero DoF (=0)"]
  NEG["Negative DoF (<0)"]
  EXP["Exploration Capacity"]
  FIX["Fixed Solution"]
  CON["Contradiction Signal"]
  N -- "adds freedom" --> DOF
  R -- "removes freedom" --> DOF
