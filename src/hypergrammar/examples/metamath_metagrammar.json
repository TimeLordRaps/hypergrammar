{
  "name": "metamath_database_metagrammar",
  "layer": "metagrammar",
  "target_layer": "grammar",
  "universe_symbol": "U",
  "ground_symbol": "$",
  "closure_operator": "L",
  "terminals": [
    "$c",
    "$v",
    "$f",
    "$e",
    "$a",
    "$p",
    "$d",
    "$.",
    "$=",
    "${",
    "$}",
    "$(",
    "$)",
    "RULE",
    "LABEL",
    "TYPECODE",
    "SYMBOL",
    "VAR",
    "EXPR",
    "PROOF",
    "ID",
    "U",
    "$",
    "ε"
  ],
  "nonterminals": [
    "DB",
    "BLOCK",
    "STMT",
    "DECL_C",
    "DECL_V",
    "HYP_F",
    "HYP_E",
    "AX_A",
    "THM_P",
    "DV_D",
    "COMMENT"
  ],
  "rules": [
    {"lhs": "DB", "rhs": ["RULE", "BLOCK", "DB"]},
    {"lhs": "DB", "rhs": ["RULE", "BLOCK"]},
    {"lhs": "BLOCK", "rhs": ["${", "STMT", "$}"]},
    {"lhs": "BLOCK", "rhs": ["STMT"]},
    {"lhs": "STMT", "rhs": ["DECL_C"]},
    {"lhs": "STMT", "rhs": ["DECL_V"]},
    {"lhs": "STMT", "rhs": ["HYP_F"]},
    {"lhs": "STMT", "rhs": ["HYP_E"]},
    {"lhs": "STMT", "rhs": ["AX_A"]},
    {"lhs": "STMT", "rhs": ["THM_P"]},
    {"lhs": "STMT", "rhs": ["DV_D"]},
    {"lhs": "STMT", "rhs": ["COMMENT"]},
    {"lhs": "DECL_C", "rhs": ["LABEL", "$c", "SYMBOL", "$."]},
    {"lhs": "DECL_V", "rhs": ["LABEL", "$v", "VAR", "$."]},
    {"lhs": "HYP_F", "rhs": ["LABEL", "$f", "TYPECODE", "VAR", "$."]},
    {"lhs": "HYP_E", "rhs": ["LABEL", "$e", "EXPR", "$."]},
    {"lhs": "AX_A", "rhs": ["LABEL", "$a", "EXPR", "$."]},
    {"lhs": "THM_P", "rhs": ["LABEL", "$p", "EXPR", "$=", "PROOF", "$."]},
    {"lhs": "DV_D", "rhs": ["LABEL", "$d", "VAR", "VAR", "$."]},
    {"lhs": "COMMENT", "rhs": ["$(", "EXPR", "$)"]}
  ],
  "derivation_chain": ["$", "L($)", "L(L($))"],
  "metadata": {
    "source": "Metamath statement families and block delimiters",
    "intent": "Test hypergrammar interpreter against a Metamath-style metagrammar"
  }
}
